{
  "name": "quiz-ebd",
  "version": "1.0.0",
  "description": "Plataforma de Quiz Interativo ao Vivo (Estilo Mentimeter / Kahoot)",
  "main": "server/index.ts",
  "scripts": {
    "start": "npx tsx server/index.ts",
    "dev": "concurrently \"npx tsx watch server/index.ts\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "keywords": [
    "quiz",
    "mentimeter",
    "kahoot",
    "ebd",
    "realtime",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^10.0.5",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
